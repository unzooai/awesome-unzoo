# Local installers and release staging: never commit distribution binaries.
/inbox/*
!/inbox/.gitkeep
/dist/
/outputs/
*.apk
*.aab
*.ipa
*.dmg
*.pkg
*.exe
*.msi
*.msix
*.appx
*.deb
*.rpm
*.AppImage
*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.tgz
*.tar.xz
*.bin
*.app/
*.p12
*.pfx
*.pem
*.key
*.keystore
*.jks
.env
.env.*
.DS_Store
__pycache__/
*.py[cod]
.venv/
